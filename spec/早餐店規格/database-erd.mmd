erDiagram
    MENU_ITEMS ||--o{ ORDER_ITEMS : contains
    ORDERS ||--|{ ORDER_ITEMS : includes
    MENU_ITEMS ||--o{ COMPETITOR_PRICES : compares
    COMPETITORS ||--o{ COMPETITOR_PRICES : supplies

    MENU_ITEMS {
        TEXT id PK
        TEXT name
        TEXT category
        TEXT description
        INTEGER price
        TEXT badge
        TEXT image_url
        TEXT alt_text
        INTEGER is_available
    }

    ORDERS {
        TEXT id PK
        TEXT table_number
        TEXT status
        TEXT payment_status
        INTEGER total_amount
        TEXT created_at
    }

    ORDER_ITEMS {
        TEXT order_id PK, FK
        TEXT menu_item_id PK, FK
        TEXT item_name
        INTEGER unit_price
        INTEGER quantity
        INTEGER subtotal
    }

    INPUTS {
        INTEGER id PK
        TEXT input_text
        TEXT created_at
    }

    COMPETITORS {
        TEXT id PK
        TEXT name
        TEXT category
        TEXT address
        REAL latitude
        REAL longitude
        REAL rating
        INTEGER review_count
        TEXT business_hours
        TEXT phone
        TEXT website_url
        TEXT source_url
        TEXT source_checked_at
        TEXT notes
        INTEGER is_active
    }
    COMPETITOR_PRICES {
        TEXT competitor_id PK, FK
        TEXT menu_item_id PK, FK
        INTEGER price
        TEXT product_name
        TEXT price_source_url
        TEXT price_checked_at
        TEXT price_notes
    }
